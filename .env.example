# ============================================================================
# YouTube Automation Stack — environment variables
# Copy this file to ".env" and fill in the blanks. Keep .env PRIVATE.
# ============================================================================

# ----------------------------------------------------------------------------
# 1) Postiz core secrets — ALREADY GENERATED for you. You may keep these.
# ----------------------------------------------------------------------------
# IMPORTANT: changing JWT_SECRET after first run invalidates existing Postiz
# API keys (they're AES-encrypted with this key). Set it once and leave it.
JWT_SECRET=1290246bf73ad97fdd66393ad1a185235916b8a1b95cccf258b5fcb2947caf57

# Raise Postiz public-API rate limit from the default 30/hr so n8n bursts
# don't get throttled. 90/hr is the documented self-host ceiling.
API_LIMIT=90

# ----------------------------------------------------------------------------
# 2) Postiz — YouTube OAuth (fill in Phase 3 of SETUP.md)
#    From Google Cloud Console → APIs & Services → Credentials → OAuth client.
# ----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# 3) n8n — encryption key (ALREADY GENERATED). Protects stored credentials.
#    If you change it, credentials must be re-entered.
# ----------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=81c5a02cacc1600cd93d20c05fcc963111ad4331a2cd262b762f7d32cb6c5d69

# n8n timezone & localhost-in-Docker alias (Windows Docker Desktop maps
# host.docker.internal to your PC automatically).
GENERIC_TIMEZONE=UTC
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# ----------------------------------------------------------------------------
# 4) Postiz API key — filled in Phase 4 of SETUP.md
#    (Postiz UI → Settings → Developers → Public API → "Rotate")
# ----------------------------------------------------------------------------
POSTIZ_API_KEY=

# Postiz public-API base URL. The n8n workflow calls {{POSTIZ_BASE_URL}}/posts
# etc. Backend serves /public/v1, exposed on host port 4007.
POSTIZ_BASE_URL=http://localhost:4007/public/v1

# ----------------------------------------------------------------------------
# 5) Ollama — runs ON YOUR HOST (not in Docker). n8n reaches it through
#    host.docker.internal. Verify it's bound to 0.0.0.0 in Phase 1.
# ----------------------------------------------------------------------------
OLLAMA_HOST_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ----------------------------------------------------------------------------
# 6) faster-whisper — runs inside the Docker stack on the shared network.
# ----------------------------------------------------------------------------
WHISPER_URL=http://faster-whisper:8000

# ----------------------------------------------------------------------------
# 7) Google Sheet — filled in Phase 5 of SETUP.md
#    The document ID is the long string in the sheet URL:
#    https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# ----------------------------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Videos

# ---- Threads publishing (Meta app with "Threads API" product) ----
# Produced by: node threads-publisher.mjs auth  (token valid ~60 days, refresh with: node threads-publisher.mjs refresh)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ---- TikTok Content Posting API (developers.tiktok.com app) ----
# Produced by: node tiktok-publisher.mjs auth  (refresh token valid ~1 year)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
