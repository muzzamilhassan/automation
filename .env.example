# .env.example — CURRENT system (rewritten 2026-10-17, issue #85)
# The old n8n/Postiz config is gone: production runs on GitHub Actions +
# Quarry Studio (Next.js on Vercel) + Neon Postgres. Copy to .env and fill in.

# ---- YouTube (Data API v3) ----
# OAuth client for uploads, verification, archive, reports
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Per-channel refresh tokens: locally yt-mcp/channels/<slug>/token.json,
# in CI as secrets named YT_TOKEN_<SLUG_UPPER_SNAKE>
# YOUTUBE_REFRESH_TOKEN (sweeper/reporting fallback path)

# ---- Script brains (5-layer free chain: Gemini -> Groq -> Cerebras -> Mistral -> HF) ----
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=

# ---- Voice / media ----
OPENAI_API_KEY=          # TTS (gpt-4o-mini-tts) + whisper alignment
LONGVIDEO_GEMINI_API_KEY=
LONGVIDEO_GROQ_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
AGNES_API_KEY=           # AI thumbnail backgrounds (Studio /api/thumbs/ai-bg)

# ---- Social publishers ----
FB_PAGE_TOKEN=           # Meta Graph token for FB Pages (Reels + posters)
FACEBOOK_APP_ID=         # used by threads-publisher
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
# THREADS_ACCESS_TOKEN=  # CI-only static token path (no refresh — prefer the JSON file)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=    # currently MISSING in live .env -> Pinterest channel is dead (#68)
PINTEREST_ACCESS_TOKEN=
# TikTok publishing: PAUSED 10-17 — Zernio removed; moves to the Quarry Studio
# TikTok app once its developer approval lands (quarry-studio-server.mjs +
# tiktok-app-site/). Keys live in .env at that point.
# TikTok Quarry Studio app (approval pending): server falls back to these if
# TIKTOK_APP_KEY/SECRET are unset
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# TIKTOK_CLIENT_KEY=     # fallback aliases for the same two values
# TIKTOK_CLIENT_SECRET=

# ---- Studio (Next.js on Vercel) ----
DATABASE_URL=            # Neon Postgres pooled connection string
STUDIO_PASSWORD=         # REQUIRED — sessions/connect links are forgeable without it (#58)
GITHUB_TOKEN=            # Studio -> repo writes (Contents API, secrets)

# ---- Ops / alerts ----
GITHUB_PAT=              # archive + reports + watch-runs (classic PAT)
NTFY_TOPIC=              # phone alerts
DAILY_DEV_TOKEN=         # daily.dev digest push
