      ],
      "lines": [
        { "say": "DashBite takes about four thousand orders every hour.", "mood": "warm", "cues": [
          { "on": "DashBite", "do": "show", "widget": "b" },
          { "on": "four", "do": "show", "widget": "s" },
          { "on": "hour", "do": "show", "widget": "c" }
        ] },
        { "say": "Support needs one thing: order number 4187.", "mood": "calm", "cues": [
          { "on": "needs", "do": "mark", "widget": "b", "index": 0 },
          { "on": "4187", "do": "fill", "widget": "b", "index": 0, "value": "#4187", "tone": "good" }
        ] },
        { "say": "Here's the code everyone writes first.", "mood": "calm", "cues": [
          { "on": "code", "do": "line", "widget": "c", "line": 2 }
        ] },
        { "say": "It walks the whole list, one order at a time.", "mood": "calm", "cues": [
          { "on": "walks", "do": "line", "widget": "c", "line": 3 },
          { "on": "list", "afterMs": 250, "do": "fill", "widget": "b", "index": 1, "value": "#2934" }
