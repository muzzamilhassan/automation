   "lines": [
    {
     "say": "LAPPY wants to send a secret note to SHELF but worries a nosy POSTMAN might read it.",
     "mood": "warm",
     "pauseMs": 500,
     "cues": [
      {
       "on": "LAPPY",
       "do": "show",
       "widget": "b"
      }
     ]
    },
    {
     "say": "Think of it as a secret handshake before opening a tunnel.",
     "mood": "playful",
     "pauseMs": 600,
     "cues": [
      {
       "on": "handshake",
       "do": "stamp",
       "text": "*SECRET* HANDSHAKE"
      }
     ]
    },
    {
     "say": "First, LAPPY says hello and asks SHELF to show its certificate.",
     "mood": "calm",
     "pauseMs": 500,
     "cues": [
      {
       "on": "hello",
       "do": "step",
       "widget": "s",
       "step": 1,
       "text": "LAPPY → SHELF: Hello + Cert?",
       "ok": true
      }
     ]
    },
    {
     "say": "Second, they compare the certificate to the trusted DNS BOOK and agree on a shared secret key.",
     "mood": "serious",
     "pauseMs": 500,
     "cues": [
      {
       "on": "compare",
       "do": "step",
       "widget": "s",
       "step": 2,
       "text": "Check cert vs DNS BOOK, agree key",
       "ok": true
      }
     ]
    },
    {
     "say": "Third, every later packet the POSTMAN carries is scrambled, so he only sees noise.",
     "mood": "excited",
     "pauseMs": 500,
     "cues": [
      {
       "on": "scrambled",
       "do": "step",
       "widget": "s",
       "step": 3,
       "text": "All later packets encrypted",
       "ok": true
      }
